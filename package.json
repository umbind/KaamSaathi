{
  "name": "kaamsaathi-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "KaamSaathi Hyperlocal Marketplace - Production Monorepo",
  "scripts": {
    "build": "pnpm --filter \"./packages/**\" --filter \"./services/**\" --filter \"./apps/admin\" --filter \"./apps/web\" build",
    "test": "pnpm --filter \"./packages/**\" --filter \"./services/**\" --filter \"./apps/admin\" --filter \"./apps/web\" test",
    "lint": "pnpm --filter \"./packages/**\" --filter \"./services/**\" --filter \"./apps/admin\" --filter \"./apps/web\" lint",
    "seed:pilot": "pnpm --filter @kaamsaathi/api build && pnpm --filter @kaamsaathi/api seed:pilot"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
